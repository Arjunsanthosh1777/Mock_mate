# ==============================================================================
# MOCKMATE Environment Configuration
# ==============================================================================
# Copy this file to .env for local development.
# Never expose API keys in frontend code; all AI calls execute on the server.

# Preferred AI provider: "auto" (uses OPENAI_API_KEY if set, else GEMINI_API_KEY),
# "openai", or "gemini"
AI_PROVIDER="auto"

# OpenAI API Configuration (Primary when OPENAI_API_KEY is provided)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional custom OpenAI-compatible base URL
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Gemini API Configuration (Automatically injected in AI Studio runtime)
# Free-tier models: "gemini-3.1-flash-lite" (fast) or "gemini-3.8-flash" (reasoning)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# SQLite Database Path (Defaults to ./data/mockmate.db)
SQLITE_DB_PATH="./data/mockmate.db"

# Server Port (Must be 3000 in AI Studio preview)
PORT="3000"

# Application URL
APP_URL="http://localhost:3000"

